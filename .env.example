# Server Configuration
PORT=3000
NODE_ENV=development

# OmniDimension Credentials & Telephony
# Obtain these from your OmniDimension Dashboard (API Management & Agents)
OMNIDIM_API_KEY=replace_with_server_secret
OMNIDIM_BASE_URL=https://omnidim.io/api/v1
OMNIDIM_AGENT_ID=123456
OMNIDIM_FROM_NUMBER_ID=123

# Security Tokens (Generate high-entropy random strings)
VOICE_TOOL_TOKEN=secret_tool_token_xyz123
VOICE_WEBHOOK_TOKEN=secret_webhook_token_abc789
VOICE_WEBHOOK_URL=http://localhost:3000/api/v1/voice/webhook/secret_webhook_token_abc789

# Database Configuration (MySQL 8.0)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=ADD_YOUR_MYSQL_PASSWORD
DB_NAME=voice_crm

# Feature Flags
ENABLE_REAL_CALLING=false
